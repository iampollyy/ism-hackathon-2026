# Footage, renders and working files never go into the public repo:
# they hold faces and voices of real people. Share them through the team Drive.
raw/*
!raw/.gitkeep
work/
out/
# Screenshots of other people's reels: private style references only.
references/*
!references/.gitkeep

# Keys and test sessions
.env
.secrets/

# Installed packages
tools/.venv/
tools/node_modules/
remotion/node_modules/
__pycache__/

# Pitch video media (team footage, cloned-voice voice-over): never in the repo
remotion/public/pitch/
remotion/public/hero/
remotion/public/reel-shield/
remotion/public/reel-team/
remotion/public/reel-live/
remotion/public/linkedin/
remotion/public/demo-day/
