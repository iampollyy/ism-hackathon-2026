# Copy to .env and fill in. Names only here; never commit real values.

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_WELCOME_AGENT_ID=
ELEVENLABS_PRACTICE_AGENT_ID=
ELEVENLABS_FAMILY_LINE_AGENT_ID=
ELEVENLABS_POLICE_VOICE_ID=
ELEVENLABS_BANK_VOICE_ID=
ELEVENLABS_NURSE_VOICE_ID=
# true: every ElevenLabs call returns fakes, so the whole flow runs without voice
FAKE_ELEVENLABS=false

# Model providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional, for the weekly run
FIRECRAWL_API_KEY=

# Model per job: first choice,second choice (docs/ai.md job table)
PROFILER_MODELS=gpt-6-astra,claude-opus-5-5
PLANNER_MODELS=gpt-6-astra,claude-opus-5-5
DIGEST_MODELS=gpt-6-astra,claude-opus-5-5
DIRECTOR_MODELS=claude-haiku-5-5,gpt-6-luna
SCORER_MODELS=claude-haiku-5-5,gpt-6-luna
WEEKLY_NOTE_MODELS=claude-haiku-5-5,gpt-6-luna

# Storage (relative paths are under backend/)
DATABASE_URL=sqlite:///data/app.db
MEDIA_DIR=media

# Background loop that rings scheduled calls (tests switch it off)
SCHEDULER_ENABLED=true
